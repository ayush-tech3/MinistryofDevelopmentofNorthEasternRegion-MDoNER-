# ==============================================================================
# AlertNex - Environment Configuration Template
# AI-Based Early Warning & Landslide Monitoring Decision-Support System
# Ministry of Development of North Eastern Region (MDoNER) | SIH 2026 (SIH26001)
# ==============================================================================

# --- Backend Application Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=True
PROTOTYPE_MODE=True

# --- Database Layer Configuration ---
# 1. Zero-setup Embedded SQLite (Default for Evaluation & Hackathon Demo)
DATABASE_URL=sqlite:///./alertnex.db

# 2. Production PostgreSQL 16 + PostGIS Spatial Geodatabase (Uncomment for Production)
# DATABASE_URL=postgresql://alertnex_user:alertnex_secret_pass@localhost:5432/alertnex_db

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://ministryofdevelopmentofnortheastern.netlify.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,https://ministryofdevelopmentofnortheastern.netlify.app,https://ayush-tech3.github.io

# --- File Storage & Uploads ---
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Multi-Channel Emergency Dispatch (Optional) ---
# SMTP Emergency Email Dispatch (Alerts sent to District Magistrates & NDRF)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alertnex.disaster.response@gmail.com
SMTP_PASS=your_app_specific_password_here
FROM_EMAIL=alertnex.disaster.response@gmail.com

# Twilio Emergency SMS Dispatch (Runs in simulated fallback mode if blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

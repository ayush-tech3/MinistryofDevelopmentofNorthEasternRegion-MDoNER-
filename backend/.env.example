# AlertNex - Environment Configuration (SIH26001)
PROJECT_NAME=AlertNex
ENV=development
API_V1_STR=/api

# Database Configuration
# For live PostgreSQL + PostGIS container/server:
# DATABASE_URL=postgresql://alertnex_user:alertnex_secret_pass@localhost:5432/alertnex_db
# Automatic fallback to local SQLite when DATABASE_URL is not set or Postgres is offline:
DATABASE_URL=sqlite:///./alertnex.db

# File Uploads Directory
UPLOAD_DIR=backend/uploads

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080"]

# Prototype Safety & Honesty Flag
PROTOTYPE_MODE=true

# AlertNex - Environment Configuration (SIH26001)
PROJECT_NAME=AlertNex
ENV=development
API_V1_STR=/api

# Database Configuration
# For live PostgreSQL + PostGIS container/server:
# DATABASE_URL=postgresql://alertnex_user:alertnex_secret_pass@localhost:5432/alertnex_db
# Automatic fallback to local SQLite when DATABASE_URL is not set or Postgres is offline:
DATABASE_URL=sqlite:///./alertnex.db

# File Uploads Directory
UPLOAD_DIR=backend/uploads

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080"]

# Prototype Safety & Honesty Flag
PROTOTYPE_MODE=true

# Real Email Delivery Configuration (SMTP)
# For Gmail: Use smtp.gmail.com with an App Password (generated from myaccount.google.com/apppasswords)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=AlertNex Disaster Early Warning (SIH26001)

# Auto-Alert Recipients (triggered automatically when zone risk = HIGH or CRITICAL)
AUTO_ALERT_EMAILS=recipient1@gmail.com,recipient2@gmail.com
# AUTO_ALERT_PHONES=+919876543210,+919876543211

# SMS Configuration (Twilio)
# Sign up at https://www.twilio.com/ for free trial
SMS_ENABLED=true
SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX

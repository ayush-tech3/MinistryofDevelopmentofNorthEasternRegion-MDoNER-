# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# Database files
alertnex.db
*.sqlite
*.sqlite3

# Environment / Secrets
.env
*.env.local

# Node / Frontend build artifacts
node_modules/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# OS / Editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Backend uploads (keep directory structure, ignore uploaded files)
backend/uploads/*
!backend/uploads/.gitkeep

# Test / temporary files
test_page.html
test_fpdf.pdf

# Generated presentation/document build scripts output
# (keep the scripts, ignore generated output artifacts)
*.pyc
